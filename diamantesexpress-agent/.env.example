# Copie este archivo a %LOCALAPPDATA%\DiamantesExpressAgent\.env (o defina variables de entorno).
# Nombres oficiales de la especificación de DiamantesExpress. Las variables de entorno tienen prioridad
# sobre settings.json. NO guarde el token en archivos: use Configuración o `dxagent-cli.exe set-secret agent-token`
# (Administrador de credenciales de Windows / DPAPI).

DX_API_BASE_URL=https://<dominio-publicado>/hcgi/api
# DX_AGENT_TOKEN=dxa_...            # solo para pruebas; en producción, almacén seguro
DX_AGENT_NAME=PC-WINDOWS-01
# ADB_PATH=C:\platform-tools\adb.exe   # vacío = adb del emulador (HD-Adb.exe / adb.exe de LDPlayer) o del PATH
# ADB_DEVICE_SERIAL=emulator-5554      # vacío = puerto de la instancia del emulador
AGENT_POLL_SECONDS=10
AGENT_HEARTBEAT_SECONDS=30
# simulation | supervised | production  (modo local; el servidor manda y el local solo restringe)
AGENT_MODE=simulation

# --- OpenAI (solo en esta PC) ---
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_AI_COST_PER_ORDER_USD=0.25
DAILY_AI_BUDGET_USD=5

# --- Emulador: bluestacks | ldplayer (también se elige en el instalador y en Configuración) ---
# DX_EMULATOR=ldplayer      # si se define, tiene prioridad sobre lo elegido en Configuración
# BlueStacks: nombre interno (Pie64_1). LDPlayer: índice (0 = principal) o nombre.
# EMULATOR_INSTANCE=0

# --- Avanzado (prefijo DXAGENT_ + nombre del campo de settings.json) ---
# DXAGENT_DEVICE_BACKEND=adb
# DXAGENT_WORKFLOW_ID=freefire_gift_supervised     # flujo real (cuando esté validado)
# DXAGENT_CLOSE_EMULATOR_ON_STOP=true
# DXAGENT_ALLOW_INSECURE_HTTP_LOCALHOST=true        # solo con `dxagent mock-backend`
# DXAGENT_ROUTE_OVERRIDES={"claimTask": "POST /agent/tasks/claim"}
