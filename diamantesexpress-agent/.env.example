# Copie este archivo a %LOCALAPPDATA%\DiamantesExpressAgent\.env (o defina variables de entorno).
# Las variables de entorno tienen prioridad sobre settings.json. NO guarde secretos en settings.json:
# use la pantalla Configuración o `DiamantesExpressAgent.exe set-secret` (Administrador de credenciales).

# --- DiamantesExpress (Hostinger Horizons) ---
DIAMANTESEXPRESS_API_URL=https://REEMPLAZAR/api/agent/v1
DIAMANTESEXPRESS_AGENT_ID=
# Preferible: emparejar desde la interfaz. Solo para pruebas:
# DIAMANTESEXPRESS_AGENT_TOKEN=
POLL_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=30

# --- OpenAI ---
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_AI_COST_PER_ORDER_USD=0.25
DAILY_AI_BUDGET_USD=5

# --- Operación ---
# SIMULATION | SUPERVISED | AUTHORIZED_PRODUCTION
AUTOMATION_MODE=SIMULATION
BLUESTACKS_INSTANCE=

# --- Avanzado (prefijo DXAGENT_ + nombre del campo en settings.json) ---
# DXAGENT_DEVICE_BACKEND=adb
# DXAGENT_WORKFLOW_ID=simulation_gift
# DXAGENT_ADB_SERIAL=127.0.0.1:5555
# DXAGENT_ALLOW_INSECURE_HTTP_LOCALHOST=true   # solo con `dxagent mock-backend`
# DXAGENT_ROUTE_OVERRIDES={"claimJob": "POST /tareas/{job_id}/reclamar"}
